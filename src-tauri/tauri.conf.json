{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puplify",
  "identifier": "cz.jrydel.puplify",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run fetch:models && bun run dev:ui",
    "beforeBuildCommand": "bun run fetch:models && bun run build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "Puplify",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/models/ggml-base-q5_1.bin": "models/ggml-base-q5_1.bin",
      "resources/models/ggml-silero-v5.1.2.bin": "models/ggml-silero-v5.1.2.bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libpulse0"],
        "files": { "/usr/share/metainfo/cz.jrydel.puplify.metainfo.xml": "cz.jrydel.puplify.metainfo.xml" }
      },
      "rpm": {
        "depends": ["pulseaudio-libs"],
        "files": { "/usr/share/metainfo/cz.jrydel.puplify.metainfo.xml": "cz.jrydel.puplify.metainfo.xml" }
      },
      "appimage": {
        "files": { "/usr/share/metainfo/cz.jrydel.puplify.metainfo.xml": "cz.jrydel.puplify.metainfo.xml" }
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNjg2NDI4NjgyOUNENEEKUldSS3pTbG9LR1JvbkdaUDJRdjkrLy9ObE9HYngyTU5wZ2hxY3dYVDBJaHZUNllFcG9oa3ppSHkK",
      "endpoints": ["https://github.com/jrydel/puplify/releases/latest/download/latest.json"]
    }
  }
}
