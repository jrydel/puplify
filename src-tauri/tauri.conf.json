{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puplify",
  "identifier": "cz.jrydel.puplify",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev:ui",
    "beforeBuildCommand": "bun run build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "Puplify",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": { "depends": ["libpulse0"] },
      "rpm": { "depends": ["pulseaudio-libs"] }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
